<?xml version="1.0" encoding="utf-8"?>
<!--
  Hardware configuration for the legacy Celigo (controller firmware 1.3.0, four EZStepper
  V7.21 motors), in the vendor USBIOHardwareConfig.config format read by
  pylabrobot.revvity.celigo.CeligoHardwareConfig.from_xml.

  Values marked MEASURED come from the runs in tools/celigo_legacy/runs. X/Y speeds,
  accelerations and currents follow the vendor sample in pylabrobot's Celigo tests (same
  0.0127 mm/tick lead screw), with MaxVelocity 30 mm/s; homing speeds stay slow because
  they set how precisely the sensor edge is found. Values marked PROVISIONAL are
  assumptions to calibrate once the camera is connected (lead screws, Z pitch, galvo range).

  Units follow the vendor files: linear axes in mm, mm/s, mm/s^2 and encoder ticks for
  HomingShortMove; optical axes in encoder ticks and ticks/s.
-->
<USBIOHardwareConfig>
  <xmlSerializerSection type="Cyntellect.Hardware.Instrument.USBIOConfig.USBIOConfigurationFile, Instrument.USBIOConfig">
    <USBIOConfigurationFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

      <!-- Motor 1: side-to-side stage. Positive moves the stage left. Home sensor (bit 2)
           at the right end, where the door is; far sensor (bit 3) at the left end.
           MEASURED: 200 ticks/turn, 256 microsteps/tick, ~10139 ticks between sensors.
           PROVISIONAL: 0.1 inch lead (0.0127 mm/tick), so travel is ~128.8 mm. -->
      <XAxis xmlns="Cyntellect.com/USBIOConfig.xsd">
        <MotionName>X Axis</MotionName>
        <ConfigVersion>1001</ConfigVersion>
        <MotorType>0</MotorType>
        <CommIndex>1</CommIndex>
        <ControllerIndex>0</ControllerIndex>
        <AxisIndex>1</AxisIndex>
        <Enabled>true</Enabled>
        <MaxVelocity>30</MaxVelocity>
        <MaxAcceleration>45</MaxAcceleration>
        <MaxDeceleration>45</MaxDeceleration>
        <MaxSAcceleration>0</MaxSAcceleration>
        <ModerateAccleration>45</ModerateAccleration>
        <MinimumAcceleration>45</MinimumAcceleration>
        <ModerateSAcceleration>0</ModerateSAcceleration>
        <MinimumSAcceleration>0</MinimumSAcceleration>
        <SCurveSupport>false</SCurveSupport>
        <HomeType>NormalWithHardstopCheck</HomeType>
        <HomingVelocity>1.0</HomingVelocity>
        <IndexVelocity>0.5</IndexVelocity>
        <HomingShortMove>500</HomingShortMove>
        <HomeOffset>0</HomeOffset>
        <PositiveLimit>true</PositiveLimit>
        <NegativeLimit>true</NegativeLimit>
        <LimitPolarity>0</LimitPolarity>
        <InvertAxisDirection>false</InvertAxisDirection>
        <DefaultPositiveDirection>true</DefaultPositiveDirection>
        <MovingCurrentPercentage>65</MovingCurrentPercentage>
        <HoldingCurrentPercentage>20</HoldingCurrentPercentage>
        <LoadingCurrentPercentage>55</LoadingCurrentPercentage>
        <MovingOverloadLimit>500</MovingOverloadLimit>
        <Mode_EnableLimits>true</Mode_EnableLimits>
        <Mode_EnableStepAndDirection>false</Mode_EnableStepAndDirection>
        <Mode_EnablePositionCorrection>false</Mode_EnablePositionCorrection>
        <Mode_EnableMotorSlaveToEncoder>false</Mode_EnableMotorSlaveToEncoder>
        <CoursePositionErrorWindow>100</CoursePositionErrorWindow>
        <FinePositionErrorWindow>10</FinePositionErrorWindow>
        <Gain>1</Gain>
        <EncoderToMotorTickRatio>256</EncoderToMotorTickRatio>
        <BacklashCompensation>0</BacklashCompensation>
        <MotorResponseTime>1</MotorResponseTime>
        <MinPosition>1</MinPosition>
        <MaxPosition>125</MaxPosition>
        <MMPerEncoderTick>0.0127</MMPerEncoderTick>
      </XAxis>

      <!-- Motor 2: front/back stage. Positive moves the stage toward the front and out of
           the door. Home sensor (bit 2) at the rear; far sensor (bit 3) at the front.
           MEASURED: 200 ticks/turn, ~19960 ticks between sensors, ~14 ticks reversal slack.
           PROVISIONAL: 0.1 inch lead, so travel is ~253 mm. -->
      <YAxis xmlns="Cyntellect.com/USBIOConfig.xsd">
        <MotionName>Y Axis</MotionName>
        <ConfigVersion>1001</ConfigVersion>
        <MotorType>0</MotorType>
        <CommIndex>1</CommIndex>
        <ControllerIndex>0</ControllerIndex>
        <AxisIndex>2</AxisIndex>
        <Enabled>true</Enabled>
        <MaxVelocity>30</MaxVelocity>
        <MaxAcceleration>45</MaxAcceleration>
        <MaxDeceleration>45</MaxDeceleration>
        <MaxSAcceleration>0</MaxSAcceleration>
        <ModerateAccleration>45</ModerateAccleration>
        <MinimumAcceleration>45</MinimumAcceleration>
        <ModerateSAcceleration>0</ModerateSAcceleration>
        <MinimumSAcceleration>0</MinimumSAcceleration>
        <SCurveSupport>false</SCurveSupport>
        <HomeType>NormalWithHardstopCheck</HomeType>
        <HomingVelocity>1.0</HomingVelocity>
        <IndexVelocity>0.5</IndexVelocity>
        <HomingShortMove>500</HomingShortMove>
        <HomeOffset>0</HomeOffset>
        <PositiveLimit>true</PositiveLimit>
        <NegativeLimit>true</NegativeLimit>
        <LimitPolarity>0</LimitPolarity>
        <InvertAxisDirection>false</InvertAxisDirection>
        <DefaultPositiveDirection>true</DefaultPositiveDirection>
        <MovingCurrentPercentage>65</MovingCurrentPercentage>
        <HoldingCurrentPercentage>20</HoldingCurrentPercentage>
        <LoadingCurrentPercentage>55</LoadingCurrentPercentage>
        <MovingOverloadLimit>500</MovingOverloadLimit>
        <Mode_EnableLimits>true</Mode_EnableLimits>
        <Mode_EnableStepAndDirection>false</Mode_EnableStepAndDirection>
        <Mode_EnablePositionCorrection>false</Mode_EnablePositionCorrection>
        <Mode_EnableMotorSlaveToEncoder>false</Mode_EnableMotorSlaveToEncoder>
        <CoursePositionErrorWindow>100</CoursePositionErrorWindow>
        <FinePositionErrorWindow>10</FinePositionErrorWindow>
        <Gain>1</Gain>
        <EncoderToMotorTickRatio>256</EncoderToMotorTickRatio>
        <BacklashCompensation>0</BacklashCompensation>
        <MotorResponseTime>1</MotorResponseTime>
        <MinPosition>1</MinPosition>
        <MaxPosition>250</MaxPosition>
        <MMPerEncoderTick>0.0127</MMPerEncoderTick>
      </YAxis>

      <!-- Motor 3: focus. Positive moves the objective UP toward the sample (collision
           direction); home sensor (bit 2) at the bottom. No upper sensor was searched.
           MEASURED: 1600 ticks/turn, 32 microsteps/tick, 8.2 turns clear above the sensor.
           PROVISIONAL: 0.001 mm/tick and a 5 mm upper bound until calibrated. -->
      <ZSingleAxis xmlns="Cyntellect.com/USBIOConfig.xsd">
        <MotionName>Z Axis</MotionName>
        <ConfigVersion>1001</ConfigVersion>
        <MotorType>0</MotorType>
        <CommIndex>1</CommIndex>
        <ControllerIndex>0</ControllerIndex>
        <AxisIndex>3</AxisIndex>
        <Enabled>true</Enabled>
        <MaxVelocity>0.32</MaxVelocity>
        <MaxAcceleration>2</MaxAcceleration>
        <MaxDeceleration>2</MaxDeceleration>
        <MaxSAcceleration>0</MaxSAcceleration>
        <ModerateAccleration>2</ModerateAccleration>
        <MinimumAcceleration>2</MinimumAcceleration>
        <ModerateSAcceleration>0</ModerateSAcceleration>
        <MinimumSAcceleration>0</MinimumSAcceleration>
        <SCurveSupport>false</SCurveSupport>
        <HomeType>NormalWithHardstopCheck</HomeType>
        <HomingVelocity>0.32</HomingVelocity>
        <IndexVelocity>0.16</IndexVelocity>
        <HomingShortMove>800</HomingShortMove>
        <HomeOffset>0</HomeOffset>
        <PositiveLimit>false</PositiveLimit>
        <NegativeLimit>true</NegativeLimit>
        <LimitPolarity>0</LimitPolarity>
        <InvertAxisDirection>false</InvertAxisDirection>
        <DefaultPositiveDirection>true</DefaultPositiveDirection>
        <MovingCurrentPercentage>30</MovingCurrentPercentage>
        <HoldingCurrentPercentage>10</HoldingCurrentPercentage>
        <LoadingCurrentPercentage>30</LoadingCurrentPercentage>
        <MovingOverloadLimit>500</MovingOverloadLimit>
        <Mode_EnableLimits>true</Mode_EnableLimits>
        <Mode_EnableStepAndDirection>false</Mode_EnableStepAndDirection>
        <Mode_EnablePositionCorrection>false</Mode_EnablePositionCorrection>
        <Mode_EnableMotorSlaveToEncoder>false</Mode_EnableMotorSlaveToEncoder>
        <CoursePositionErrorWindow>100</CoursePositionErrorWindow>
        <FinePositionErrorWindow>10</FinePositionErrorWindow>
        <Gain>1</Gain>
        <EncoderToMotorTickRatio>32</EncoderToMotorTickRatio>
        <BacklashCompensation>0</BacklashCompensation>
        <MotorResponseTime>1</MotorResponseTime>
        <MinPosition>0.5</MinPosition>
        <MaxPosition>5</MaxPosition>
        <MMPerEncoderTick>0.001</MMPerEncoderTick>
      </ZSingleAxis>

      <!-- Motor 4: 4-position dichroic wheel. Rates are encoder ticks/s.
           MEASURED: 2000 ticks/motor turn, 8000 ticks/wheel turn (4 motor turns), encoder
           index once per motor turn, position-one flag clears bit 2 (LimitPolarity 1),
           663 ticks wide. HomeOffset 58 centers position 1 on the flag (flag-mapping run);
           filter centers in the light path are not yet calibrated. -->
      <DichroicFilterWheel xmlns="Cyntellect.com/USBIOConfig.xsd">
        <MotionName>Dichroic</MotionName>
        <ConfigVersion>1001</ConfigVersion>
        <MotorType>0</MotorType>
        <CommIndex>1</CommIndex>
        <ControllerIndex>0</ControllerIndex>
        <AxisIndex>4</AxisIndex>
        <Enabled>true</Enabled>
        <MaxVelocity>400</MaxVelocity>
        <MaxAcceleration>400</MaxAcceleration>
        <MaxDeceleration>400</MaxDeceleration>
        <MaxSAcceleration>0</MaxSAcceleration>
        <ModerateAccleration>400</ModerateAccleration>
        <MinimumAcceleration>400</MinimumAcceleration>
        <ModerateSAcceleration>0</ModerateSAcceleration>
        <MinimumSAcceleration>0</MinimumSAcceleration>
        <SCurveSupport>false</SCurveSupport>
        <HomeType>Normal_Accurate</HomeType>
        <HomingVelocity>400</HomingVelocity>
        <IndexVelocity>200</IndexVelocity>
        <HomingShortMove>200</HomingShortMove>
        <HomeOffset>58</HomeOffset>
        <PositiveLimit>false</PositiveLimit>
        <NegativeLimit>false</NegativeLimit>
        <LimitPolarity>1</LimitPolarity>
        <InvertAxisDirection>false</InvertAxisDirection>
        <DefaultPositiveDirection>true</DefaultPositiveDirection>
        <MovingCurrentPercentage>30</MovingCurrentPercentage>
        <HoldingCurrentPercentage>10</HoldingCurrentPercentage>
        <LoadingCurrentPercentage>30</LoadingCurrentPercentage>
        <MovingOverloadLimit>500</MovingOverloadLimit>
        <Mode_EnableLimits>false</Mode_EnableLimits>
        <Mode_EnableStepAndDirection>false</Mode_EnableStepAndDirection>
        <Mode_EnablePositionCorrection>false</Mode_EnablePositionCorrection>
        <Mode_EnableMotorSlaveToEncoder>false</Mode_EnableMotorSlaveToEncoder>
        <CoursePositionErrorWindow>100</CoursePositionErrorWindow>
        <FinePositionErrorWindow>10</FinePositionErrorWindow>
        <Gain>1</Gain>
        <EncoderToMotorTickRatio>25.6</EncoderToMotorTickRatio>
        <BacklashCompensation>0</BacklashCompensation>
        <MotorResponseTime>1</MotorResponseTime>
        <NumberOfEncoderTickPerRev>8000</NumberOfEncoderTickPerRev>
        <NumberOfFilters>4</NumberOfFilters>
        <FilterMap><LogicalNumber>1</LogicalNumber><PhysicalNumber>1</PhysicalNumber></FilterMap>
        <FilterMap><LogicalNumber>2</LogicalNumber><PhysicalNumber>2</PhysicalNumber></FilterMap>
        <FilterMap><LogicalNumber>3</LogicalNumber><PhysicalNumber>3</PhysicalNumber></FilterMap>
        <FilterMap><LogicalNumber>4</LogicalNumber><PhysicalNumber>4</PhysicalNumber></FilterMap>
      </DichroicFilterWheel>

      <!-- Galvos: MEASURED to calibrate (window 20/20) and settle in ~30 ms.
           PROVISIONAL: +/-1 V, no inversion, until the imaging range is calibrated. -->
      <XGalvo xmlns="Cyntellect.com/USBIOConfig.xsd">
        <ConfigVersion>1000</ConfigVersion>
        <ControllerIndex>0</ControllerIndex>
        <PositionErrorWindow>20</PositionErrorWindow>
        <VelocityErrorWindow>20</VelocityErrorWindow>
        <BigMoveDelayMS>0</BigMoveDelayMS>
        <MinVoltage>-1</MinVoltage>
        <MaxVoltage>1</MaxVoltage>
        <InvertVoltage>false</InvertVoltage>
        <Enabled>true</Enabled>
      </XGalvo>
      <YGalvo xmlns="Cyntellect.com/USBIOConfig.xsd">
        <ConfigVersion>1000</ConfigVersion>
        <ControllerIndex>0</ControllerIndex>
        <PositionErrorWindow>20</PositionErrorWindow>
        <VelocityErrorWindow>20</VelocityErrorWindow>
        <BigMoveDelayMS>0</BigMoveDelayMS>
        <MinVoltage>-1</MinVoltage>
        <MaxVoltage>1</MaxVoltage>
        <InvertVoltage>false</InvertVoltage>
        <Enabled>true</Enabled>
      </YGalvo>

      <!-- Illumination: MEASURED brightfield on analog output 0 (lit above the stage at
           25-70%), with pylabrobot's 0-10 V mapping and the FLOnOff strobe on bit 6.
           Fluorescence (analog 2, bits 4/5/7 in pylabrobot's map) is untested and omitted. -->
      <IOConfiguration xmlns="Cyntellect.com/USBIOConfig.xsd">
        <LightingIOs>
          <ConfigVersion>1000</ConfigVersion>
          <ControllerIndex>0</ControllerIndex>
          <Channel>0</Channel>
          <Enabled>true</Enabled>
          <Invert>false</Invert>
          <IOName>eBrightFieldIntensity</IOName>
          <MinVoltage>0</MinVoltage>
          <MaxVoltage>10</MaxVoltage>
          <DelayMS>0</DelayMS>
        </LightingIOs>
        <DigitalIOs>
          <ConfigVersion>1000</ConfigVersion>
          <IOType>Out</IOType>
          <BitIndex>6</BitIndex>
          <Invert>false</Invert>
          <Enabled>true</Enabled>
          <IOName>FLOnOff</IOName>
        </DigitalIOs>
      </IOConfiguration>

    </USBIOConfigurationFile>
  </xmlSerializerSection>
</USBIOHardwareConfig>
